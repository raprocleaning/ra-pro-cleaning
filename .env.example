# GoHighLevel CRM
GHL_API_KEY=
GHL_LOCATION_ID=pjyNLih2iktAcHvgpRiN

# ── Online booking → GoHighLevel calendar ────────────────────────────────────
# Normally leave all of these blank. Calendars are found by name through the
# GHL API using GHL_API_KEY above, so bookings reach the right calendar with no
# extra configuration.
#
# Set one only to override the automatic match — for example if a calendar is
# renamed, or two calendars have similar names and the wrong one is picked.
# Find an ID in HighLevel: Calendars → Calendar settings → it is printed under
# each calendar name, with a copy button.
GHL_CALENDAR_ID_STANDARD=
GHL_CALENDAR_ID_DEEP=
GHL_CALENDAR_ID_MOVE=
GHL_CALENDAR_ID_AIRBNB=
GHL_CALENDAR_ID_POSTCONSTRUCTION=

# Used for any service without its own ID above.
GHL_CALENDAR_ID=

# Business timezone used to place appointments. Defaults to America/Denver.
GHL_TIMEZONE=America/Denver

# Formspree email notifications
FORMSPREE_ENDPOINT=https://formspree.io/f/meerbldr

# ── Lead notification email ──────────────────────────────────────────────────
# Every website form submission (contact form, booking form, AI chat) is emailed
# to these addresses over SMTP. Comma-separate to notify more than one person.
# Defaults to pamela@raprocleaningservices.com when left blank.
LEAD_NOTIFY_TO=pamela@raprocleaningservices.com

# SMTP credentials for the mailbox the notification is sent FROM. Create a
# dedicated mailbox in cPanel → Email Accounts (for example
# website@raprocleaningservices.com) and paste its password here — do not reuse
# a personal mailbox password. cPanel shows the exact settings under
# Email Accounts → Connect Devices.
SMTP_HOST=mail.raprocleaningservices.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Leave blank. Port 465 uses TLS and 587 uses STARTTLS automatically; set
# true/false only to override that.
SMTP_SECURE=

# Optional "From" header. Defaults to the SMTP_USER mailbox.
MAIL_FROM=

# ── Form notification emails ─────────────────────────────────────────────────
# The mailbox the website sends from (cPanel → Email Accounts → Connect Devices).
# Leave blank and no email is sent; the lead still reaches the CRM and Formspree.
SMTP_USER=
SMTP_PASS=
# Defaults below already match this domain's hosting — set only to override.
SMTP_HOST=
SMTP_PORT=
# Who receives each submission. Comma-separate for more than one recipient.
LEAD_NOTIFY_TO=pamela@raprocleaningservices.com
# Where a customer's reply to their confirmation email lands.
MAIL_REPLY_TO=ra@raprocleaningservices.com

# ── Meta (Facebook) Pixel ────────────────────────────────────────────────────
# Dataset ID from Meta Business Suite → Events Manager → your dataset. Leave
# blank and the pixel never loads — the site tracks with Google Analytics only,
# exactly as before.
#
# Once set, the site sends Meta: PageView on every route, Lead on every enquiry
# (contact form, booking form, AI assistant, phone tap), Contact on a phone tap
# and Schedule with the quoted value on a completed online booking. Note this is
# NEXT_PUBLIC_ — it is compiled into the browser bundle, which is correct for a
# pixel ID and means the site must be rebuilt after changing it.
NEXT_PUBLIC_META_PIXEL_ID=
