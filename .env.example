# GoHighLevel CRM
GHL_API_KEY=
GHL_LOCATION_ID=pjyNLih2iktAcHvgpRiN

# ── Online booking → GoHighLevel calendar ────────────────────────────────────
# Normally leave all of these blank. Calendars are found by name through the
# GHL API using GHL_API_KEY above, so bookings reach the right calendar with no
# extra configuration.
#
# Set one only to override the automatic match — for example if a calendar is
# renamed, or two calendars have similar names and the wrong one is picked.
# Find an ID in HighLevel: Calendars → Calendar settings → it is printed under
# each calendar name, with a copy button.
GHL_CALENDAR_ID_STANDARD=
GHL_CALENDAR_ID_DEEP=
GHL_CALENDAR_ID_MOVE=
GHL_CALENDAR_ID_AIRBNB=
GHL_CALENDAR_ID_POSTCONSTRUCTION=

# Used for any service without its own ID above.
GHL_CALENDAR_ID=

# Business timezone used to place appointments. Defaults to America/Denver.
GHL_TIMEZONE=America/Denver

# Formspree email notifications
FORMSPREE_ENDPOINT=https://formspree.io/f/meerbldr
